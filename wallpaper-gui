#!/usr/bin/env python3
"""Small GTK4 front-end for mpvpaper (animated video wallpapers).

Shows a thumbnail gallery of video wallpapers found in Steam Workshop
folders (any folder containing project.json plus a video file), with
per-wallpaper fit, scale, offset and flip controls applied live.

Run with no arguments to open the window.
Run with --apply to start the saved wallpaper without a window (used at login).
"""
import hashlib
import json
import math
import os
import re
import shlex
import signal
import socket
import subprocess
import sys
import threading
import time

CONFIG_DIR = os.path.expanduser("~/.config/wallpaper-gui")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
THUMB_DIR = os.path.expanduser("~/.cache/wallpaper-gui/thumbs")
AUTOSTART_FILE = os.path.expanduser("~/.config/autostart/wallpaper-gui.desktop")
MPVPAPER = os.path.expanduser("~/.local/bin/mpvpaper")
SELF = os.path.abspath(__file__)
SOCKET = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "wallpaper-gui-mpv.sock")
# linux-wallpaperengine renders "scene" and "web" wallpapers; mpvpaper plays videos.
ENGINE_DIR = os.path.expanduser("~/.local/src/lwpe/build/output")
ENGINE_BIN = os.path.join(ENGINE_DIR, "linux-wallpaperengine")
ENGINE_PID = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "wallpaper-gui-engine.pid")
ENGINE_PATTERN = r"^\S*linux-wallpaperengine "
KINDS = ["all", "video", "scene", "web"]
KIND_LABELS = ["All types", "Video", "Scene", "Web"]
DEFAULT_LIBRARY = os.path.expanduser("~/.steam/steam/steamapps/workshop/content")
VIDEO_EXT = (".mp4", ".webm", ".mkv", ".mov", ".avi", ".m4v")
IMAGE_EXT = (".gif", ".jpg", ".jpeg", ".png", ".webp")
THUMB_W, THUMB_H = 256, 144          # 16:9 cell; other shapes are letterboxed inside it
MAX_DEPTH = 4
FITS = ["fill", "fit", "stretch"]
FIT_LABELS = ["Fill (crop to cover)", "Fit (show whole video)", "Stretch"]

DEFAULTS = {"video": "", "monitor": "", "mute": True, "loop": True,
            "autostart": False, "folders": None, "tweaks": {}}
TWEAK_DEFAULTS = {"fit": "fill", "scale": 100, "x": 0, "y": 0, "fliph": False, "flipv": False}


# ---- config ---------------------------------------------------------------
def load_config():
    try:
        with open(CONFIG_FILE) as f:
            cfg = {**DEFAULTS, **json.load(f)}
    except (OSError, ValueError):
        cfg = dict(DEFAULTS)
    if cfg["folders"] is None:
        cfg["folders"] = [DEFAULT_LIBRARY] if os.path.isdir(DEFAULT_LIBRARY) else []
    if not isinstance(cfg["tweaks"], dict):
        cfg["tweaks"] = {}
    return cfg


def save_config(cfg):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)


def get_tweaks(cfg, video):
    t = cfg["tweaks"].get(video)
    return {**TWEAK_DEFAULTS, **t} if isinstance(t, dict) else dict(TWEAK_DEFAULTS)


# ---- library --------------------------------------------------------------
def scan_folders(folders):
    """Find wallpapers: folders holding project.json.

    Each item has a "kind" (video, scene or web) and a "key": the video file
    for videos, the project folder for scene and web wallpapers.
    """
    items, seen = [], set()
    for root in folders:
        root = os.path.realpath(root)
        for d, subdirs, files in os.walk(root):
            if os.path.relpath(d, root).count(os.sep) >= MAX_DEPTH:
                subdirs[:] = []
            if "project.json" not in files:
                continue
            subdirs[:] = []
            try:
                with open(os.path.join(d, "project.json"), encoding="utf-8", errors="replace") as f:
                    meta = json.load(f)
            except (OSError, ValueError):
                meta = {}
            if not isinstance(meta, dict):
                meta = {}
            kind = str(meta.get("type", "")).strip().lower()
            video = None
            name = meta.get("file")
            if isinstance(name, str) and name.lower().endswith(VIDEO_EXT) \
                    and os.path.isfile(os.path.join(d, name)):
                video = os.path.join(d, name)
            elif kind not in ("scene", "web"):
                for name in sorted(files):
                    if name.lower().endswith(VIDEO_EXT):
                        video = os.path.join(d, name)
                        break
            if video:
                kind, key = "video", video
            elif kind in ("scene", "web"):
                key = d
            else:
                continue
            if key in seen:
                continue
            seen.add(key)
            preview = None
            name = meta.get("preview")
            if isinstance(name, str) and os.path.isfile(os.path.join(d, name)):
                preview = os.path.join(d, name)
            else:
                for name in sorted(files):
                    if name.lower().startswith("preview") and name.lower().endswith(IMAGE_EXT):
                        preview = os.path.join(d, name)
                        break
            title = meta.get("title")
            if not isinstance(title, str) or not title.strip():
                title = os.path.basename(d)
            items.append({"title": title.strip(), "kind": kind, "key": key,
                          "video": video, "preview": preview})
    items.sort(key=lambda i: i["title"].lower())
    return items


def library_signature(folders):
    """Cheap fingerprint of the library folders; changes when items are added or removed."""
    sig = []
    for root in folders:
        try:
            for name in sorted(os.listdir(root)):
                p = os.path.join(root, name)
                if os.path.isdir(p):
                    sig.append((p, os.stat(p).st_mtime_ns))
        except OSError:
            pass
    return sig


def thumb_path(video):
    """Cache location of the frame thumbnail for a video (may not exist yet)."""
    try:
        st = os.stat(video)
    except OSError:
        return None
    key = hashlib.sha1(f"{video}|{st.st_mtime_ns}|{st.st_size}".encode()).hexdigest()
    return os.path.join(THUMB_DIR, key + ".jpg")


def make_thumb(video):
    """Grab a frame from the video so the thumbnail has the wallpaper's real shape."""
    out = thumb_path(video)
    if not out:
        return None
    if os.path.isfile(out) and os.path.getsize(out) > 0:
        return out
    os.makedirs(THUMB_DIR, exist_ok=True)
    for seek in ("2", "0"):
        try:
            subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", seek, "-i", video,
                            "-frames:v", "1", "-vf", f"scale={THUMB_W * 2}:-2", out],
                           stdin=subprocess.DEVNULL, capture_output=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired):
            return None
        if os.path.isfile(out) and os.path.getsize(out) > 0:
            return out
    try:
        os.remove(out)
    except OSError:
        pass
    return None


# ---- mpvpaper -------------------------------------------------------------
def list_monitors():
    """Return enabled monitor names, e.g. ['DP-3']."""
    try:
        out = subprocess.run(["cosmic-randr", "list"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    out = re.sub(r"\x1b\[[0-9;]*m", "", out)
    return [m.group(1) for m in re.finditer(r"^(\S+) \(enabled\)", out, re.M)]


def tweak_props(t):
    """Translate tweaks into mpv properties."""
    scale = min(max(float(t["scale"]), 10.0), 1000.0)
    return {
        "panscan": 1.0 if t["fit"] == "fill" else 0.0,
        "keepaspect": t["fit"] != "stretch",
        "video-zoom": round(math.log2(scale / 100.0), 4),
        "video-pan-x": round(float(t["x"]) / 100.0, 4),
        "video-pan-y": round(float(t["y"]) / 100.0, 4),
    }


def tweak_vf(t):
    return ",".join(n for n, on in (("hflip", t["fliph"]), ("vflip", t["flipv"])) if on)


def mpv_send(commands):
    """Send commands to the running wallpaper. Returns False if it is not reachable."""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.5)
        s.connect(SOCKET)
        for c in commands:
            s.sendall((json.dumps({"command": c}) + "\n").encode())
        s.close()
        return True
    except OSError:
        return False


def apply_tweaks_live(t):
    cmds = [["set_property", k, v] for k, v in tweak_props(t).items()]
    cmds.append(["vf", "set", tweak_vf(t)])
    return mpv_send(cmds)


def is_engine_item(key):
    """Scene and web wallpapers are folders; videos are files."""
    return bool(key) and os.path.isdir(key)


def is_running():
    return any(subprocess.run(c, capture_output=True).returncode == 0
               for c in (["pgrep", "-x", "mpvpaper"], ["pgrep", "-f", ENGINE_PATTERN]))


def stop_wallpaper():
    """Stop whichever wallpaper program is running (video player or engine)."""
    subprocess.run(["pkill", "-x", "mpvpaper"], capture_output=True)
    try:
        with open(ENGINE_PID) as f:
            os.killpg(int(f.read().strip()), signal.SIGTERM)
    except (OSError, ValueError):
        pass
    subprocess.run(["pkill", "-f", ENGINE_PATTERN], capture_output=True)
    # An engine whose picture is hidden behind another one can ignore the polite
    # request, so wait briefly and then force-stop whatever is left.
    for _ in range(10):
        if subprocess.run(["pgrep", "-f", ENGINE_PATTERN], capture_output=True).returncode != 0:
            break
        time.sleep(0.1)
    else:
        subprocess.run(["pkill", "-KILL", "-f", ENGINE_PATTERN], capture_output=True)
    try:
        os.remove(ENGINE_PID)
    except OSError:
        pass


def start_engine(cfg, key):
    """Start linux-wallpaperengine for a scene or web wallpaper."""
    if not os.path.isfile(ENGINE_BIN):
        return "Scene and web wallpapers need linux-wallpaperengine in " + ENGINE_DIR
    stop_wallpaper()
    t = get_tweaks(cfg, key)
    cmd = ["./linux-wallpaperengine", "--screen-root", cfg["monitor"], "--bg", key,
           "--scaling", t["fit"] if t["fit"] in FITS else "fill"]
    if cfg["mute"]:
        cmd.append("--silent")
    p = subprocess.Popen(cmd, cwd=ENGINE_DIR, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    try:
        with open(ENGINE_PID, "w") as f:
            f.write(str(p.pid))
    except OSError:
        pass
    return None


def start_wallpaper(cfg):
    """Start the selected wallpaper detached. Returns an error string or None."""
    if not cfg["video"] or not os.path.exists(cfg["video"]):
        return "Pick a wallpaper first."
    if not cfg["monitor"]:
        return "No monitor selected."
    if is_engine_item(cfg["video"]):
        return start_engine(cfg, cfg["video"])
    if not os.path.isfile(MPVPAPER):
        return "mpvpaper not found at " + MPVPAPER
    stop_wallpaper()
    t = get_tweaks(cfg, cfg["video"])
    opts = ["input-ipc-server=" + SOCKET]
    if cfg["mute"]:
        opts.append("no-audio")
    if cfg["loop"]:
        opts.append("loop")
    for k, v in tweak_props(t).items():
        opts.append(f"{k}={('yes' if v else 'no') if isinstance(v, bool) else v}")
    if tweak_vf(t):
        opts.append("vf=" + tweak_vf(t))
    cmd = [MPVPAPER, "-f", "-o", " ".join(opts), cfg["monitor"], cfg["video"]]
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    return None


def set_autostart(enabled):
    if enabled:
        os.makedirs(os.path.dirname(AUTOSTART_FILE), exist_ok=True)
        with open(AUTOSTART_FILE, "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Wallpaper GUI (apply saved wallpaper)\n"
                    f"Exec={shlex.quote(SELF)} --apply\nX-GNOME-Autostart-Delay=5\nTerminal=false\n")
    else:
        try:
            os.remove(AUTOSTART_FILE)
        except FileNotFoundError:
            pass


