+void CImage::loadPuppetSkeleton (
+    const std::vector<char>& data, const size_t mdlsOffset, const size_t verticesOffset, const size_t vertexCount,
+    const size_t vertexStride, const size_t weightsOffset
+) {
+    try {
+	std::vector<PuppetWeights> weights (vertexCount);
+	for (size_t index = 0; index < vertexCount; index++) {
+	    PuppetCursor cursor (data, verticesOffset + index * vertexStride + weightsOffset);
+	    for (auto& bone : weights[index].bones) {
+		bone = cursor.next<uint32_t> ();
+	    }
+	    for (auto& weight : weights[index].weights) {
+		weight = cursor.next<float> ();
+	    }
+	}
+
+	if (mdlsOffset + 9 >= data.size ()) {
+	    return;
+	}
+
+	// skeleton
+	PuppetCursor cursor (data, mdlsOffset + 9);
+	cursor.next<uint32_t> ();
+	const uint16_t boneCount = cursor.next<uint16_t> ();
+	cursor.next<uint16_t> ();
+
+	std::vector<PuppetBone> bones;
+	std::vector<glm::mat4> world;
+	bones.reserve (boneCount);
+	world.reserve (boneCount);
+
+	for (uint16_t index = 0; index < boneCount; index++) {
+	    cursor.nextString ();
+	    cursor.next<int32_t> ();
+	    const uint32_t parent = cursor.next<uint32_t> ();
+	    const uint32_t matrixSize = cursor.next<uint32_t> ();
+	    if (matrixSize != 64) {
+		throw std::runtime_error ("unexpected bone matrix size");
+	    }
+
+	    PuppetBone bone;
+	    for (int column = 0; column < 4; column++) {
+		for (int row = 0; row < 4; row++) {
+		    bone.local[column][row] = cursor.next<float> ();
+		}
+	    }
+	    cursor.nextString ();
+
+	    bone.parent = parent == 0xFFFFFFFF ? -1 : static_cast<int> (parent);
+	    if (bone.parent >= static_cast<int> (index)) {
+		throw std::runtime_error ("bone refers to a later bone as its parent");
+	    }
+
+	    world.push_back (bone.parent < 0 ? bone.local : world[bone.parent] * bone.local);
+	    bone.inverseBind = glm::inverse (world.back ());
+	    bones.push_back (bone);
+	}
+
+	// animations
+	std::vector<PuppetAnimation> animations;
+	const size_t mdlaOffset = findPuppetMarker (data, "MDLA", cursor.offset ());
+
+	if (mdlaOffset + 9 <= data.size () && std::atoi (std::string (data.data () + mdlaOffset + 4, 4).c_str ()) != 0) {
+	    PuppetCursor section (data, mdlaOffset + 9);
+	    section.next<uint32_t> ();
+	    const uint32_t animationCount = section.next<uint32_t> ();
+	    if (animationCount > 256) {
+		throw std::runtime_error ("unreasonable animation count");
+	    }
+
+	    size_t searchFrom = section.offset ();
+
+	    for (uint32_t index = 0; index < animationCount; index++) {
+		const size_t header = findPuppetAnimationHeader (data, searchFrom, bones.size ());
+		if (header >= data.size ()) {
+		    break;
+		}
+
+		PuppetCursor anim (data, header);
+		PuppetAnimation animation;
+		animation.id = static_cast<int> (anim.next<uint32_t> ());
+		anim.next<int32_t> ();
+		anim.nextString ();
+		const std::string mode = anim.nextString ();
+		animation.fps = anim.next<float> ();
+		animation.length = anim.next<int32_t> ();
+		anim.next<int32_t> ();
+		const uint32_t trackCount = anim.next<uint32_t> ();
+		if (trackCount > 4096) {
+		    throw std::runtime_error ("unreasonable animation track count");
+		}
+
+		for (uint32_t track = 0; track < trackCount; track++) {
+		    anim.next<int32_t> ();
+		    const uint32_t bytes = anim.next<uint32_t> ();
+		    std::vector<PuppetFrame> frames (bytes / 36);
+		    for (auto& frame : frames) {
+			for (int axis = 0; axis < 3; axis++) {
+			    frame.position[axis] = anim.next<float> ();
+			}
+			for (int axis = 0; axis < 3; axis++) {
+			    frame.angles[axis] = anim.next<float> ();
+			}
+			for (int axis = 0; axis < 3; axis++) {
+			    frame.scale[axis] = anim.next<float> ();
+			}
+		    }
+		    anim.skip (bytes % 36);
+		    animation.tracks.push_back (std::move (frames));
+		}
+		searchFrom = anim.offset ();
+
+		animation.mode = mode == "mirror" ? 1 : (mode == "single" ? 2 : 0);
+		if (animation.fps > 0.0f && animation.length > 0) {
+		    animations.push_back (std::move (animation));
+		}
+	    }
+	}
+
+	this->m_puppetWeights = std::move (weights);
+	this->m_puppetBones = std::move (bones);
+	this->m_puppetAnimations = std::move (animations);
+	this->m_puppetBindPositions = this->m_puppetRawPositions;
+	sLog.out (
+	    "Loaded puppet skeleton ", *this->getImage ().model->puppet, " bones=", this->m_puppetBones.size (),
+	    " animations=", this->m_puppetAnimations.size ()
+	);
+    } catch (const std::exception& ex) {
+	// the mesh still draws in its rest pose
+	sLog.error ("Could not load puppet skeleton ", *this->getImage ().model->puppet, ": ", ex.what ());
+	this->m_puppetBones.clear ();
+	this->m_puppetAnimations.clear ();
+	this->m_puppetWeights.clear ();
+    }
+}
+
+bool CImage::computePuppetPose (const float time, std::vector<GLfloat>& output) const {
+    if (this->m_puppetBones.empty () || this->m_puppetAnimations.empty ()
+	|| this->getImage ().animationLayers.empty () || this->m_puppetBindPositions.empty ()) {
+	return false;
+    }
+
+    const size_t boneCount = this->m_puppetBones.size ();
+    std::vector<glm::vec3> position (boneCount);
+    std::vector<glm::vec3> angles (boneCount);
+    std::vector<glm::vec3> scale (boneCount);
+    std::vector<bool> animated (boneCount, false);
+
+    // start every bone from its rest pose (puppets are flat, so only the rotation around Z matters)
+    for (size_t bone = 0; bone < boneCount; bone++) {
+	const glm::mat4& local = this->m_puppetBones[bone].local;
+	position[bone] = glm::vec3 (local[3]);
+	angles[bone] = glm::vec3 (0.0f, 0.0f, std::atan2 (local[0][1], local[0][0]));
+	scale[bone] = glm::vec3 (
+	    glm::length (glm::vec3 (local[0])), glm::length (glm::vec3 (local[1])), glm::length (glm::vec3 (local[2]))
+	);
+    }
+
+    bool any = false;
+
+    for (const auto& layer : this->getImage ().animationLayers) {
+	if (!layer->visible->value->getBool ()) {
+	    continue;
+	}
+	const float blend = layer->blend->value->getFloat ();
+	if (blend <= 0.0f) {
+	    continue;
+	}
+
+	const int id = layer->animation->value->getInt ();
+	const auto found = std::ranges::find_if (this->m_puppetAnimations, [id] (const PuppetAnimation& cur) {
+	    return cur.id == id;
+	});
+	if (found == this->m_puppetAnimations.end ()) {
+	    continue;
+	}
+	const PuppetAnimation& animation = *found;
+	const auto length = static_cast<float> (animation.length);
+	const float elapsed = time * layer->rate->value->getFloat () * animation.fps;
+	float frame;
+
+	if (animation.mode == 2) {
+	    frame = std::clamp (elapsed, 0.0f, length);
+	} else if (animation.mode == 1) {
+	    frame = std::fmod (elapsed, length * 2.0f);
+	    if (frame < 0.0f) {
+		frame += length * 2.0f;
+	    }
+	    if (frame > length) {
+		frame = length * 2.0f - frame;
+	    }
+	} else {
+	    frame = std::fmod (elapsed, length);
+	    if (frame < 0.0f) {
+		frame += length;
+	    }
+	}
+
+	for (size_t bone = 0; bone < boneCount && bone < animation.tracks.size (); bone++) {
+	    const auto& track = animation.tracks[bone];
+	    if (track.empty ()) {
+		continue;
+	    }
+
+	    const size_t first = std::min (static_cast<size_t> (frame), track.size () - 1);
+	    const size_t second = std::min (first + 1, track.size () - 1);
+	    const float mix = frame - std::floor (frame);
+	    const glm::vec3 curPosition = glm::mix (track[first].position, track[second].position, mix);
+	    const glm::vec3 curAngles = glm::mix (track[first].angles, track[second].angles, mix);
+	    const glm::vec3 curScale = glm::mix (track[first].scale, track[second].scale, mix);
+
+	    if (layer->additive) {
+		// additive layers contribute their change since the animation's first frame
+		const PuppetFrame& base = track[0];
+		glm::vec3 ratio = glm::vec3 (1.0f);
+		for (int axis = 0; axis < 3; axis++) {
+		    if (std::abs (base.scale[axis]) > 0.00001f) {
+			ratio[axis] = curScale[axis] / base.scale[axis];
+		    }
+		}
+		position[bone] += blend * (curPosition - base.position);
+		angles[bone] += blend * (curAngles - base.angles);
+		scale[bone] *= glm::mix (glm::vec3 (1.0f), ratio, blend);
+	    } else {
+		position[bone] = glm::mix (position[bone], curPosition, blend);
+		angles[bone] = glm::mix (angles[bone], curAngles, blend);
+		scale[bone] = glm::mix (scale[bone], curScale, blend);
+	    }
+	    animated[bone] = true;
+	}
+
+	any = true;
+    }
+
+    if (!any) {
+	return false;
+    }
+
+    // bone transforms in model space, then the matrix that carries a rest-pose vertex to its animated place
+    std::vector<glm::mat4> skin (boneCount);
+    for (size_t bone = 0; bone < boneCount; bone++) {
+	const PuppetBone& info = this->m_puppetBones[bone];
+	const glm::mat4 local
+	    = animated[bone] ? puppetLocalMatrix (position[bone], angles[bone], scale[bone]) : info.local;
+	skin[bone] = info.parent < 0 ? local : skin[info.parent] * local;
+    }
+    for (size_t bone = 0; bone < boneCount; bone++) {
+	skin[bone] = skin[bone] * this->m_puppetBones[bone].inverseBind;
+    }
+
+    const size_t vertexCount = std::min (this->m_puppetWeights.size (), this->m_puppetBindPositions.size () / 3);
+    output.resize (this->m_puppetBindPositions.size ());
+
+    for (size_t index = 0; index < vertexCount; index++) {
+	const glm::vec4 rest (
+	    this->m_puppetBindPositions[index * 3], this->m_puppetBindPositions[index * 3 + 1],
+	    this->m_puppetBindPositions[index * 3 + 2], 1.0f
+	);
+	const PuppetWeights& binding = this->m_puppetWeights[index];
+	glm::vec3 result (0.0f);
+	float total = 0.0f;
+
+	for (int slot = 0; slot < 4; slot++) {
+	    const float weight = binding.weights[slot];
+	    if (weight <= 0.0f || binding.bones[slot] >= boneCount) {
+		continue;
+	    }
+	    result += weight * glm::vec3 (skin[binding.bones[slot]] * rest);
+	    total += weight;
+	}
+
+	if (total > 0.0f) {
+	    result /= total;
+	} else {
+	    result = glm::vec3 (rest);
+	}
+
+	output[index * 3] = result.x;
+	output[index * 3 + 1] = result.y;
+	output[index * 3 + 2] = result.z;
+    }
+
+    return true;
+}
+
+void CImage::updatePuppetAnimation () {
+    if (this->m_hasPuppetMesh && this->computePuppetPose (this->getScene ().getTime (), this->m_puppetRawPositions)) {
+	this->updatePuppetPositionBuffer (this->m_size);
+    }
+}
