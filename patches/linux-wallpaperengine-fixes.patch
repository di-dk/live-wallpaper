+namespace {
+std::vector<DynamicValue*>& timelineValues () {
+    static std::vector<DynamicValue*> values;
+    return values;
+}
+
+float sampleTimeline (const std::vector<DynamicValue::TimelineKey>& keys, const float frame, const float fallback) {
+    if (keys.empty ()) {
+	return fallback;
+    }
+    if (frame <= keys.front ().frame) {
+	return keys.front ().value;
+    }
+    for (size_t index = 0; index + 1 < keys.size (); index++) {
+	const auto& from = keys[index];
+	const auto& to = keys[index + 1];
+	if (frame > to.frame) {
+	    continue;
+	}
+	const float span = to.frame - from.frame;
+	float mix = span > 0.0f ? (frame - from.frame) / span : 1.0f;
+	// the editor's default curve handles ease in and out
+	mix = mix * mix * (3.0f - 2.0f * mix);
+	return from.value + (to.value - from.value) * mix;
+    }
+    return keys.back ().value;
+}
+} // namespace
+
+void DynamicValue::setTimeline (Timeline timeline) {
+    if (!this->m_timeline.has_value ()) {
+	timelineValues ().push_back (this);
+    }
+    this->m_timeline = std::move (timeline);
+}
+
+void DynamicValue::tickTimelines (const float time) {
+    for (DynamicValue* value : timelineValues ()) {
+	value->applyTimeline (time);
+    }
+}
+
+void DynamicValue::applyTimeline (const float time) {
+    const Timeline& timeline = *this->m_timeline;
+    float length = timeline.length;
+    for (const auto& channel : timeline.channels) {
+	if (!channel.empty ()) {
+	    length = std::max (length, channel.back ().frame);
+	}
+    }
+    if (length <= 0.0f) {
+	return;
+    }
+
+    float frame = time * timeline.fps;
+    if (timeline.mode == 2) {
+	frame = std::min (frame, length);
+    } else if (timeline.mode == 1) {
+	frame = std::fmod (frame, length * 2.0f);
+	if (frame > length) {
+	    frame = length * 2.0f - frame;
+	}
+    } else {
+	frame = std::fmod (frame, length);
+    }
+
+    const auto channel = [&timeline, frame] (const size_t index, const float fallback) {
+	return index < timeline.channels.size () ? sampleTimeline (timeline.channels[index], frame, fallback) : fallback;
+    };
+
+    switch (this->m_type) {
+	case Float:
+	    this->update (channel (0, this->m_float), UpdateSource::Script);
+	    break;
+	case Int:
+	    this->update (static_cast<int> (std::lround (channel (0, static_cast<float> (this->m_int)))), UpdateSource::Script);
+	    break;
+	case Boolean:
+	    this->update (channel (0, this->m_bool ? 1.0f : 0.0f) > 0.5f, UpdateSource::Script);
+	    break;
+	case Vec2:
+	    this->update (glm::vec2 (channel (0, this->m_vec2.x), channel (1, this->m_vec2.y)), UpdateSource::Script);
+	    break;
+	case Vec3:
+	    this->update (
+		glm::vec3 (channel (0, this->m_vec3.x), channel (1, this->m_vec3.y), channel (2, this->m_vec3.z)),
+		UpdateSource::Script
+	    );
+	    break;
+	case Vec4:
+	    this->update (
+		glm::vec4 (
+		    channel (0, this->m_vec4.x), channel (1, this->m_vec4.y), channel (2, this->m_vec4.z),
+		    channel (3, this->m_vec4.w)
+		),
+		UpdateSource::Script
+	    );
+	    break;
+	default:
+	    break;
+    }
+}
