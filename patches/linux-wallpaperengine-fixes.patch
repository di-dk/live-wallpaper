+/** translate * rotateZ * rotateY * rotateX * scale, angles in radians */
+glm::mat4 puppetLocalMatrix (const glm::vec3& position, const glm::vec3& angles, const glm::vec3& scale) {
+    glm::mat4 result = glm::translate (glm::mat4 (1.0f), position);
