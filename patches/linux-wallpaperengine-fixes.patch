+
+    // vertices that fall outside the layer, over all the sampled poses
+    const auto clipped = [&poses, &size] (const glm::vec2& offset) {
+	size_t count = 0;
+	for (const auto& pose : poses) {
+	    for (size_t index = 0; index + 2 < pose.size (); index += 3) {
+		if (std::abs (pose[index] - offset.x) > size.x / 2.0f
+		    || std::abs (pose[index + 1] - offset.y) > size.y / 2.0f) {
+		    count++;
+		}
+	    }
+	}
+	return count;
+    };
+
+    const size_t clippedInPlace = clipped ({ 0.0f, 0.0f });
+    if (clippedInPlace == 0) {
+	return;
+    }
+
+    // only move the mesh when that clearly helps: some models are meant to leave the layer,
+    // for example a character that hides and comes back
+    const glm::vec2 centre = (lowest + highest) / 2.0f;
+    if (clipped (centre) * 2 < clippedInPlace) {
+	this->m_puppetOffset = centre;
+	sLog.out (
+	    "Puppet mesh ", *this->getImage ().model->puppet, " moved inside its layer by ", centre.x, ", ", centre.y
+	);
+    }
+}
