+void CImage::choosePuppetOffset (const glm::vec2& size) {
+    this->m_puppetOffset = { 0.0f, 0.0f };
+
+    if (this->m_puppetBindPositions.empty ()) {
+	return;
+    }
+
+    // the rest pose plus samples across the longest visible animation
+    std::vector<std::vector<GLfloat>> poses = { this->m_puppetBindPositions };
+    float longest = 0.0f;
+
+    for (const auto& layer : this->getImage ().animationLayers) {
+	if (!layer->visible->value->getBool ()) {
+	    continue;
+	}
+	const int id = layer->animation->value->getInt ();
+	const auto found = std::ranges::find_if (this->m_puppetAnimations, [id] (const PuppetAnimation& cur) {
+	    return cur.id == id;
+	});
+	if (found == this->m_puppetAnimations.end ()) {
+	    continue;
+	}
+	const float rate = std::max (std::abs (layer->rate->value->getFloat ()), 0.01f);
+	longest = std::max (longest, static_cast<float> (found->length) / found->fps / rate);
+    }
+
+    if (longest > 0.0f) {
+	constexpr int samples = 24;
+	for (int sample = 0; sample < samples; sample++) {
+	    std::vector<GLfloat> pose;
+	    if (this->computePuppetPose (longest * static_cast<float> (sample) / samples, pose)) {
+		poses.push_back (std::move (pose));
+	    }
+	}
+    }
+
+    glm::vec2 lowest { std::numeric_limits<float>::max () };
+    glm::vec2 highest { std::numeric_limits<float>::lowest () };
+    for (const auto& pose : poses) {
+	for (size_t index = 0; index + 2 < pose.size (); index += 3) {
+	    lowest = glm::min (lowest, glm::vec2 (pose[index], pose[index + 1]));
+	    highest = glm::max (highest, glm::vec2 (pose[index], pose[index + 1]));
+	}
