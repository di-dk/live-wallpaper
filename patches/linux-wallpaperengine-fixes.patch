\ No newline at end of file
+CefRefPtr<CefRenderHandler> BrowserClient::GetRenderHandler () { return m_renderHandler; }
+
+CefRefPtr<CefLoadHandler> BrowserClient::GetLoadHandler () { return this; }
+
+void BrowserClient::OnLoadEnd (CefRefPtr<CefBrowser> browser, CefRefPtr<CefFrame> frame, int httpStatusCode) {
+    if (!frame->IsMain ()) {
+	return;
+    }
+
+    // The properties come as a JSON object in Wallpaper Engine's format:
+    //   { "name": { "value": ... }, ... }
+    // taken from the LWPE_WEB_PROPERTIES environment variable. Without it the page still
+    // gets the callback, with an empty object.
+    const char* env = std::getenv ("LWPE_WEB_PROPERTIES");
+    std::string properties = env != nullptr ? env : "{}";
+
+    if (properties.empty () || properties.front () != '{') {
+	properties = "{}";
+    }
+
+    // the listener may be registered a little after the load event, so retry for a few seconds
+    const std::string script = "(function(){var p=" + properties
+	+ ";var n=0;(function go(){var l=window.wallpaperPropertyListener;"
+	  "if(l){try{if(l.applyGeneralProperties){l.applyGeneralProperties({fps:60});}"
+	  "if(l.applyUserProperties){l.applyUserProperties(p);}}"
+	  "catch(e){console.log('wallpaper properties: '+e);}}"
+	  "else if(n++<100){setTimeout(go,100);}})();})();";
+
+    frame->ExecuteJavaScript (script, frame->GetURL (), 0);
+}
