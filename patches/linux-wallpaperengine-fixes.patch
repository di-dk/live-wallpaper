+	if (total > 0.0f) {
+	    result /= total;
+	} else {
+	    result = glm::vec3 (rest);
+	}
+
+	output[index * 3] = result.x;
+	output[index * 3 + 1] = result.y;
+	output[index * 3 + 2] = result.z;
+    }
+
+    return true;
+}
