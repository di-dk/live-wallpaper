+	for (size_t index = 0; index < indexBytes / sizeof (uint16_t); index++) {
+	    uint16_t value;
+	    std::memcpy (&value, data.data () + indicesOffset + index * sizeof (uint16_t), sizeof (value));
+	    highest = std::max (highest, value);
+	}
+
+	// vertex sizes seen in the wild, the one the format word suggests first. Position comes first,
+	// and bone indices, weights and uv are always the last 40 bytes
+	std::vector<size_t> strides;
+	if (format == 0x0180000F) {
+	    strides = { 80, 84, 52, 56 };
+	} else if ((format >> 16) == 0x0181) {
+	    strides = { 84, 80, 56, 52 };
+	} else {
+	    strides = { 52, 56, 80, 84 };
+	}
