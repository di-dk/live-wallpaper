+/** Bounds-checked little-endian reader over a puppet model file */
+class PuppetCursor {
+public:
+    PuppetCursor (const std::vector<char>& data, const size_t offset) : m_data (data), m_offset (offset) { }
+
+    template <typename T> T next () {
+	if (this->m_offset + sizeof (T) > this->m_data.size ()) {
+	    throw std::runtime_error ("puppet model is truncated");
+	}
+	T value;
+	std::memcpy (&value, this->m_data.data () + this->m_offset, sizeof (T));
+	this->m_offset += sizeof (T);
+	return value;
+    }
+
+    std::string nextString () {
+	std::string out;
+	while (true) {
+	    const char c = this->next<char> ();
+	    if (c == '\0') {
+		break;
+	    }
+	    out += c;
+	}
+	return out;
+    }
+
+    void skip (const size_t bytes) {
+	if (this->m_offset + bytes > this->m_data.size ()) {
+	    throw std::runtime_error ("puppet model is truncated");
+	}
+	this->m_offset += bytes;
+    }
+
+    [[nodiscard]] size_t offset () const { return this->m_offset; }
