+namespace {
+/** Bounds-checked little-endian reader over a puppet model file */
+class PuppetCursor {
+public:
+    PuppetCursor (const std::vector<char>& data, const size_t offset) : m_data (data), m_offset (offset) { }
+
+    template <typename T> T next () {
+	if (this->m_offset + sizeof (T) > this->m_data.size ()) {
+	    throw std::runtime_error ("puppet model is truncated");
+	}
+	T value;
+	std::memcpy (&value, this->m_data.data () + this->m_offset, sizeof (T));
+	this->m_offset += sizeof (T);
+	return value;
+    }
+
+    std::string nextString () {
+	std::string out;
+	while (true) {
+	    const char c = this->next<char> ();
+	    if (c == '\0') {
+		break;
+	    }
+	    out += c;
+	}
+	return out;
+    }
+
+    void skip (const size_t bytes) {
+	if (this->m_offset + bytes > this->m_data.size ()) {
+	    throw std::runtime_error ("puppet model is truncated");
+	}
+	this->m_offset += bytes;
+    }
+
+    [[nodiscard]] size_t offset () const { return this->m_offset; }
+
+private:
+    const std::vector<char>& m_data;
+    size_t m_offset;
+};
+
+size_t findPuppetMarker (const std::vector<char>& data, const char* marker, const size_t from) {
+    const size_t length = strlen (marker);
+    for (size_t offset = from; offset + length <= data.size (); offset++) {
+	if (std::memcmp (data.data () + offset, marker, length) == 0) {
+	    return offset;
+	}
+    }
+    return data.size ();
+}
+
+/** Where the first mesh of a puppet model sits in the file and how its vertices are laid out */
+struct PuppetLayout {
+    size_t verticesOffset;
+    size_t vertexBytes;
+    size_t stride;
+    size_t indexBytes;
+    size_t weightsOffset;
+    size_t uvOffset;
+};
+
+/**
+ * Reads the model header. Older models use 52-byte vertices (position, bone indices, weights, uv),
+ * newer ones 80-byte vertices with 28 extra bytes after the position.
+ */
+std::optional<PuppetLayout> parsePuppetLayout (const std::vector<char>& data) {
+    try {
+	PuppetCursor cursor (data, 9);
+	cursor.next<int32_t> ();
+	cursor.next<int32_t> ();
+	cursor.next<int32_t> ();
+	cursor.nextString ();
+	cursor.next<int32_t> ();
+
+	uint32_t vertexBytes = cursor.next<uint32_t> ();
+	bool extended = false;
+
+	if (vertexBytes == 0) {
+	    extended = true;
+	    bool found = false;
+	    for (int guard = 0; guard < 64 && !found; guard++) {
+		found = cursor.next<uint32_t> () == 0x0180000F;
+	    }
+	    if (!found) {
+		return std::nullopt;
+	    }
+	    vertexBytes = cursor.next<uint32_t> ();
+	} else if (vertexBytes == 0x01800009) {
+	    vertexBytes = cursor.next<uint32_t> ();
+	}
+
+	const size_t stride = extended ? 80 : 52;
+	if (vertexBytes == 0 || vertexBytes % stride != 0) {
+	    return std::nullopt;
+	}
+
+	const size_t verticesOffset = cursor.offset ();
+	cursor.skip (vertexBytes);
+	const uint32_t indexBytes = cursor.next<uint32_t> ();
+	if (indexBytes == 0 || indexBytes % (sizeof (uint16_t) * 3) != 0) {
+	    return std::nullopt;
+	}
+	cursor.skip (indexBytes);
+
+	return PuppetLayout {
+	    .verticesOffset = verticesOffset,
+	    .vertexBytes = vertexBytes,
+	    .stride = stride,
+	    .indexBytes = indexBytes,
+	    .weightsOffset = extended ? size_t { 40 } : size_t { 12 },
+	    .uvOffset = extended ? size_t { 72 } : size_t { 44 },
+	};
+    } catch (const std::exception&) {
+	return std::nullopt;
+    }
+}
+
+/**
+ * Finds the next animation header at or after the given offset and returns where its id field
+ * starts. The data that follows an animation's keyframes varies between models (optional extra
+ * curves), so instead of interpreting it the next header is recognised by its shape: a name,
+ * then the play mode, then a frame rate, a length and one track per bone.
+ */
+size_t findPuppetAnimationHeader (const std::vector<char>& data, const size_t from, const size_t boneCount) {
+    static const char* const modes[] = { "loop", "mirror", "single" };
+
+    for (size_t offset = std::max<size_t> (from, 1); offset < data.size (); offset++) {
+	if (data[offset - 1] != '\0') {
+	    continue;
+	}
+	for (const char* mode : modes) {
+	    const size_t length = strlen (mode) + 1;
+	    const size_t after = offset + length;
+	    if (after + 16 > data.size () || std::memcmp (data.data () + offset, mode, length) != 0) {
+		continue;
+	    }
+
+	    float fps;
+	    int32_t frames;
+	    uint32_t tracks;
+	    std::memcpy (&fps, data.data () + after, sizeof (fps));
+	    std::memcpy (&frames, data.data () + after + 4, sizeof (frames));
+	    std::memcpy (&tracks, data.data () + after + 12, sizeof (tracks));
+	    if (!(fps > 0.0f && fps < 100000.0f) || frames <= 0 || tracks != boneCount) {
+		continue;
+	    }
+
+	    // the name is the string that ends right before the mode
+	    size_t nameStart = offset - 1;
+	    while (nameStart > from && data[nameStart - 1] != '\0') {
+		nameStart--;
+	    }
+	    if (nameStart >= from + 8) {
+		return nameStart - 8;
+	    }
+	}
+    }
+
+    return data.size ();
+}
