+/**
+ * Wallpaper Engine compiles these sources as HLSL on Windows, which accepts things GLSL rejects.
+ * This rewrites the common cases found in Workshop shaders so they parse as GLSL too.
+ */
+std::string relaxShaderSource (std::string source) {
+    // Windows line endings get in the way of the line-based fixes below
+    std::erase (source, '\r');
+
+    // backslash line continuations (multi-line macros) are not part of GLSL 3.30: join the lines
+    for (size_t position = 0; (position = source.find ("\\\n", position)) != std::string::npos;) {
+	source.replace (position, 2, " ");
+    }
+
+    // 1. stray semicolons after preprocessor conditions ("#elif X == 32;")
+    static const std::regex directiveSemicolon (R"((^|\n)([ \t]*#[ \t]*(?:if|elif|ifdef|ifndef|else|endif)\b[^\n;]*);[ \t]*(?=\r?\n))");
+    source = std::regex_replace (source, directiveSemicolon, "$1$2");
+
+    // 2. shaders that bring their own version of a function the header provides as a macro
+    for (const char* name : { "log10", "fmod", "saturate", "atan2", "ddx", "ddy", "lerp", "frac", "mul" }) {
+	const std::regex definition (
+	    std::string (R"((^|\n)([ \t]*(?:float|int|vec[234]|float[234])[ \t]+)") + name + R"([ \t]*\([^;{)]*\)[ \t\r\n]*\{))"
+	);
+	std::smatch match;
+	if (std::regex_search (source, match, definition)) {
+	    source.insert (static_cast<size_t> (match.position (0) + match.length (1)), std::string ("#undef ") + name + "\n");
+	}
+    }
+
+    // 3. M_PI is used by some shaders before (or without) being defined
+    static const std::regex usesPi (R"(\bM_PI\b)");
+    static const std::regex definesPi (R"((^|\n)([ \t]*#[ \t]*define[ \t]+M_PI\b))");
+    if (std::regex_search (source, usesPi)) {
+	source = "#define M_PI 3.14159265358979\n" + std::regex_replace (source, definesPi, "$1#undef M_PI\n$2");
+    }
+
+    // 4. global constants computed from uniforms ("const float A = u_B * 0.5;") become macros
+    static const std::regex globalConst (
+	R"(^([ \t]*)const[ \t]+(?:float|int|vec[234]|float[234])[ \t]+([A-Za-z_][A-Za-z0-9_]*)[ \t]*=[ \t]*([^;]*\b[ug]_[A-Za-z0-9_]+[^;]*);(.*)$)"
+    );
+    std::string result;
+    result.reserve (source.size ());
+    int depth = 0;
+    size_t start = 0;
+    while (start <= source.size ()) {
+	size_t end = source.find ('\n', start);
+	if (end == std::string::npos) {
+	    end = source.size ();
+	}
+	std::string line = source.substr (start, end - start);
+	std::smatch match;
+	if (depth == 0 && std::regex_match (line, match, globalConst)) {
+	    line = match[1].str () + "#define " + match[2].str () + " (" + match[3].str () + ")" + match[4].str ();
+	}
+	const size_t comment = line.find ("//");
+	for (size_t index = 0; index < line.size () && index < comment; index++) {
+	    if (line[index] == '{') {
+		depth++;
+	    } else if (line[index] == '}' && depth > 0) {
+		depth--;
+	    }
+	}
+	result += line;
+	if (end < source.size ()) {
+	    result += '\n';
+	}
+	start = end + 1;
+    }
+
+    return result;
+}
