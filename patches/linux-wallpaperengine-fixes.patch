+/**
+ * Reads the model header. Older models use 52-byte vertices (position, bone indices, weights, uv),
+ * newer ones 80-byte vertices with 28 extra bytes after the position.
+ */
+std::optional<PuppetLayout> parsePuppetLayout (const std::vector<char>& data, const size_t limit) {
+    try {
+	PuppetCursor cursor (data, 9);
+	cursor.next<int32_t> ();
+	cursor.next<int32_t> ();
+	cursor.next<int32_t> ();
+	cursor.nextString ();
+	cursor.next<int32_t> ();
+
+	uint32_t vertexBytes = cursor.next<uint32_t> ();
+	uint32_t format = 0x01800009;
+
+	if (vertexBytes == 0) {
+	    // newer files: padding, then a vertex format word (0x0180xxxx or 0x0181xxxx), then the size
+	    bool found = false;
+	    for (int guard = 0; guard < 64 && !found; guard++) {
+		format = cursor.next<uint32_t> ();
+		found = (format >> 16) == 0x0180 || (format >> 16) == 0x0181;
+	    }
+	    if (!found) {
+		return std::nullopt;
+	    }
+	    vertexBytes = cursor.next<uint32_t> ();
+	} else if ((vertexBytes >> 16) == 0x0180 || (vertexBytes >> 16) == 0x0181) {
+	    format = vertexBytes;
+	    vertexBytes = cursor.next<uint32_t> ();
+	}
+
+	if (vertexBytes == 0) {
+	    return std::nullopt;
+	}
+
+	const size_t verticesOffset = cursor.offset ();
+	cursor.skip (vertexBytes);
+	const uint32_t indexBytes = cursor.next<uint32_t> ();
+	const size_t indicesOffset = cursor.offset ();
+	if (indexBytes == 0 || indexBytes % (sizeof (uint16_t) * 3) != 0 || indicesOffset + indexBytes > limit) {
+	    return std::nullopt;
+	}
